{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "customer_support",
        "business_enquiry",
        "careers",
        "partnership",
        "api_integration"
      ],
      "default": "customer_support"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "closed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}