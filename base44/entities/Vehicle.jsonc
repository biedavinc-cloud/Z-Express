{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "motorbike",
        "car",
        "van",
        "truck",
        "bicycle"
      ],
      "default": "van"
    },
    "make_model": {
      "type": "string"
    },
    "capacity_kg": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "default": "active"
    },
    "hub_id": {
      "type": "string"
    },
    "assigned_driver_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "tenant_id",
    "plate_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}