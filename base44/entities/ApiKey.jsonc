{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "api_key": {
      "type": "string"
    },
    "key_prefix": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "live"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "webhook_url": {
      "type": "string"
    },
    "last_used_at": {
      "type": "string"
    },
    "call_count": {
      "type": "number",
      "default": 0
    },
    "rate_limit_per_min": {
      "type": "number",
      "default": 60
    },
    "window_started_at": {
      "type": "string"
    },
    "window_calls": {
      "type": "number",
      "default": 0
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "tenant_id",
    "api_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.member_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}